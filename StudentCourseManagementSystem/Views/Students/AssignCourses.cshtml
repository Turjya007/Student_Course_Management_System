@model StudentCourseManagementSystem.Models.Student
@{
    ViewData["Title"] = "Assign Courses";
    var courses = ViewBag.Courses as List<StudentCourseManagementSystem.Models.Course>;
}

<div class="main-card" style="max-width: 480px;">
    <h2>Assign Courses to <span class="highlight">@Model.Name</span></h2>
    <form method="post">
        <div class="form-group">
            @if (courses != null && courses.Count > 0)
            {
                @foreach (var course in courses)
                {
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="courseIds" value="@course.CourseId"
                               id="course_@course.CourseId"
                        @(Model.StudentCourses.Any(sc => sc.CourseId == course.CourseId) ? "checked" : "") />
                        <label class="form-check-label" for="course_@course.CourseId">
                            @course.Name
                        </label>
                    </div>
                }
            }
            else
            {
                <div class="alert alert-info">No courses available. Please add courses first.</div>
            }
        </div>
        <button type="submit" class="btn btn-success mt-2">Save</button>
        <a href="/Students" class="btn btn-secondary mt-2">Cancel</a>
    </form>
</div>
